# 复制成 panel/.env 后按实际修改（.env 不进仓库）
WB_UID=1000                         # 实验用户的 uid（id -u）
WB_GID=1000                         # 实验用户的 gid（id -g）
WB_HOME=/path/to/workbench-data     # 工作台数据目录
WB_DATA_ROOT=/path/to/experiments   # 只读挂载：包含 WB_HOME 和实验目录（看实时日志）
WB_USER_HOME=/home/you              # 只读挂载 ~/.codex/sessions 与 ~/.claude/projects（关联对话）
WB_PANEL_PORT=8765
# 国内构建换源（默认清华源）；海外：APT_MIRROR=deb.debian.org PIP_INDEX=https://pypi.org/simple
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
